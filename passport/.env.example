# Copy to passport/.env for Compose deployment if overriding defaults.
# Leave PASSPORT_AUTH_KEY empty to let scripts/write_config.py generate
# passport/runtime/auth_key (0600). Never commit real secrets.
PASSPORT_AUTH_KEY=
PASSPORT_CONFIG_FILE=/opt/passport/config/server.config.yaml
PASSPORT_DEVICES_FILE=/opt/passport/runtime/devices.yaml
