# Ready-to-adopt Nginx HTTPS/WSS reverse proxy template for AI Passport.
#
# Placement:
#   1) Place the `http { ... }` block (`map` + `log_format passport_safe`) in
#      /etc/nginx/conf.d/passport-logging.conf (http context).
#   2) Place the `server { ... }` block in /etc/nginx/conf.d/passport.conf
#      (or sites-enabled/passport.conf) and configure your domain + TLS cert.
#
# Security & log-safety guarantees:
# - Per-device OTA secret routes (/xiaozhi/ota/d/<secret>/) disable access logs,
#   redirect error logging to `/dev/null emerg` (never `error_log off;`), reject
#   unexpected query strings via `$passport_unsafe_query`, rewrite to
#   /xiaozhi/ota/, pass the secret in X-OTA-Secret, and strip tracing/URI
#   headers (X-Original-URI, Referer, etc.).
# - All other routes use `log_format passport_safe`, which replaces any OTA
#   secret path segment or query string via `map` and omits Authorization,
#   X-OTA-Secret, Cookie, raw $request / $request_uri / $args, and any Referer
#   variable (emitting literal `"-"` for the Referer field).
# - The site error log (`passport_error.log`) cannot be field-filtered and nginx
#   appends the raw client Referer and raw request line to its lines, so server-
#   level strict allowlists reject:
#   1) `$passport_unsafe_referer` -> `return 400`: any Referer other than
#      absent/empty or a bare HTTP(S) origin (`scheme://host[:port][/]`),
#      blocking literal, percent-encoded, dot-segment, userinfo, and query-
#      bearing Referers alike.
#   2) `$passport_unsafe_query` -> `return 400`: because Nginx's `$args` and
#      `$arg_*` do not percent-decode query keys (so `?%74oken=...` bypasses a
#      denylist on raw `$args` or `$arg_*`), this map enforces a strict
#      route-scoped allowlist on `"$is_args$args|$uri"`: only empty queries or
#      the exact `/xiaozhi/v1/?from=mqtt_gateway` handshake query are allowed;
#      all literal, percent-encoded, or unexpected query parameters are rejected
#      at server level before any location / upstream error can be logged.
# - In addition, `access_log` uses `if=$passport_log_access` to skip access-log
#   writes whenever `$passport_unsafe_referer` or `$passport_unsafe_query`
#   rejects a request (or when a server-level guard rejects a `/xiaozhi/ota/d/`
#   URI before location matching), preventing an access-log write failure /
#   short write (`[alert]`) from leaking raw `Referer` or raw query-bearing
#   request lines into `passport_error.log`.
#   Observability trade-off: 400 rejections from `$passport_unsafe_referer` or
#   `$passport_unsafe_query` are not written to `passport_access.log`;
#   permitted requests (empty query or `/xiaozhi/v1/?from=mqtt_gateway`, with
#   empty or bare-origin Referer on non-secret routes) keep full redacted
#   access logging and error logging.
# - If APM / OpenTelemetry / WAF / ingress tracing is enabled on this proxy,
#   disable trace capture or scrub `http.target`, `url.path`, `url.full`, and
#   `http.url` on `/xiaozhi/ota/d/*` so per-device secrets do not enter traces.

# --- BEGIN http {} scope (e.g. /etc/nginx/conf.d/passport-logging.conf) ---
map $uri $passport_safe_uri {
    ~(?i)/xiaozhi/+ota/+d/  "/xiaozhi/ota/d/[REDACTED]/";
    default                 $uri;
}

map $is_args $passport_safe_query {
    "?"     "?[REDACTED]";
    default "";
}

# Nginx's error log cannot filter fields: every error-log line for a request
# (e.g. `connect() failed ... while connecting to upstream`) appends the RAW
# client `referrer: "..."`. A regex denylist on raw $http_referer can be bypassed
# by percent-encoding path-segment letters (which nginx decodes when routing
# $uri), dot-segments, or repeated slashes. Instead, enforce a strict allowlist:
# only absent/empty Referer (all ESP32 firmware requests) or a bare HTTP(S)
# origin (`scheme://host[:port][/]`, no path segments, userinfo, query, fragment,
# or percent-encoding) is permitted; everything else is rejected at server level
# before any error-producing phase.
map $http_referer $passport_unsafe_referer {
    ""                                                          0;
    ~*^https?://([A-Za-z0-9.-]+|\[[0-9A-Fa-f:]+\])(:[0-9]+)?/?$ 0;
    default                                                     1;
}

# Enforce a strict route-scoped allowlist on query strings. Nginx's `$args` and
# `$arg_*` operate on raw un-decoded query bytes (per `ngx_http_parse.c`), so
# a denylist on raw `$args` or `$arg_*` can be bypassed by percent-encoded keys
# such as `?%74oken=...` while the backend (`parse_qsl`) decodes them.
# Because Passport HTTP/WS endpoints accept no query parameters other than the
# exact `/xiaozhi/v1/?from=mqtt_gateway` handshake tag, prefixing `$is_args$args`
# prevents `|` smuggling (`?|token=x`) and rejects every literal, encoded, or
# unexpected query parameter before routing or proxying. Shared with
# `$passport_log_access` so rejected query requests never attempt an access_log
# write (which on write failure / short write emits an `[alert]` containing the
# raw request line).
map "$is_args$args|$uri" $passport_unsafe_query {
    ~^\|                               0;
    "?from=mqtt_gateway|/xiaozhi/v1/"  0;
    default                            1;
}

# Skip access_log writes whenever the Referer allowlist or query allowlist
# rejects a request (or when a server-level guard rejects a
# `/xiaozhi/ota/d/` URI before location matching). Otherwise, an access_log
# write failure or short write causes Nginx (`ngx_http_log_write`) to emit an
# `[alert]` to `r->connection->log`, whose error-log formatter appends the RAW
# client `referrer` and RAW request line (including query parameter values).
# Observability trade-off: 400 rejections from `$passport_unsafe_referer` or
# `$passport_unsafe_query` are intentionally omitted from
# `passport_access.log`; allowed requests (empty or bare-origin Referer with
# empty query or exact `/xiaozhi/v1/?from=mqtt_gateway` on non-secret routes)
# keep full redacted access & error logging.
map "$passport_unsafe_referer:$passport_unsafe_query:$uri" $passport_log_access {
    ~^1:                         0;
    ~^0:1:                       0;
    ~(?i)^0:0:/xiaozhi/+ota/+d/  0;
    default                      1;
}

# Access logs omit $http_referer completely (emitting literal `"-"`) so no
# client-supplied Referer encoding can ever write OTA credentials to access logs.
log_format passport_safe '$remote_addr - [$time_local] '
                         '"$request_method $passport_safe_uri$passport_safe_query $server_protocol" '
                         '$status $body_bytes_sent "-" '
                         '"$http_user_agent" req_id=$request_id';
# --- END http {} scope ---

server {
    listen 443 ssl;
    http2 on;
    server_name your-passport-host.example.com;

    ssl_certificate     /etc/ssl/passport/fullchain.pem;
    ssl_certificate_key /etc/ssl/passport/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/passport_access.log passport_safe if=$passport_log_access;
    error_log  /var/log/nginx/passport_error.log warn;

    # Site error-log guard: nginx appends the raw client Referer to every
    # error-log line (upstream failures, body-size errors, access_log write
    # `[alert]`s, ...). Reject any Referer not matching the empty/bare-origin
    # allowlist here, in the server-rewrite phase (before location matching,
    # client_max_body_size checks, and proxying), and combine with
    # `if=$passport_log_access` on `access_log` so rejected requests skip
    # access-log writes as well — preventing both upstream errors and
    # access_log write-failure alerts from writing raw Referers to error_log.
    if ($passport_unsafe_referer) {
        return 400;
    }

    # Enforce the strict route-scoped query allowlist before routing/proxying
    # (shared with `$passport_log_access` so rejected queries skip access_log writes).
    if ($passport_unsafe_query) {
        return 400;
    }

    # Per-device secret OTA path: suppress access/error logs and rewrite to /xiaozhi/ota/.
    location ^~ /xiaozhi/ota/d/ {
        access_log off;
        error_log /dev/null emerg;
        log_not_found off;
        log_subrequest off;

        if ($passport_unsafe_query) {
            return 400;
        }

        location ~ ^/xiaozhi/ota/d/(?<ota_secret_cap>[^/]+)/?$ {
            access_log off;
            error_log /dev/null emerg;
            log_not_found off;
            log_subrequest off;

            set $passport_ota_secret $ota_secret_cap;

            if ($passport_unsafe_query) {
                return 400;
            }

            rewrite ^ /xiaozhi/ota/? break;

            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Request-ID $request_id;
            proxy_set_header X-OTA-Secret $passport_ota_secret;

            # Strip raw URI/tracing/credential headers so secrets never echo upstream or to traces.
            proxy_set_header Authorization "";
            proxy_set_header X-Original-URI "";
            proxy_set_header X-Original-URL "";
            proxy_set_header X-Rewrite-URL "";
            proxy_set_header X-Forwarded-Uri "";
            proxy_set_header X-Envoy-Original-Path "";
            proxy_set_header X-Request-URI "";
            proxy_set_header Referer "";

            proxy_pass http://127.0.0.1:18013;
        }

        return 404;
    }

    location = /xiaozhi/ota/ {
        access_log /var/log/nginx/passport_access.log passport_safe if=$passport_log_access;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        proxy_set_header X-Original-URI "";
        proxy_set_header X-Original-URL "";
        proxy_set_header X-Rewrite-URL "";
        proxy_set_header X-Forwarded-Uri "";
        proxy_set_header X-Envoy-Original-Path "";
        proxy_set_header X-Request-URI "";
        proxy_set_header Referer "";

        proxy_pass http://127.0.0.1:18013;
    }

    location ^~ /xiaozhi/ota/download/ {
        access_log /var/log/nginx/passport_access.log passport_safe if=$passport_log_access;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        proxy_set_header X-Original-URI "";
        proxy_set_header X-Original-URL "";
        proxy_set_header X-Rewrite-URL "";
        proxy_set_header X-Forwarded-Uri "";
        proxy_set_header X-Envoy-Original-Path "";
        proxy_set_header X-Request-URI "";
        proxy_set_header Referer "";

        proxy_pass http://127.0.0.1:18013;
    }

    location = /mcp/vision/explain {
        access_log /var/log/nginx/passport_access.log passport_safe if=$passport_log_access;
        client_max_body_size 6m;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        proxy_set_header X-Original-URI "";
        proxy_set_header X-Original-URL "";
        proxy_set_header X-Rewrite-URL "";
        proxy_set_header X-Forwarded-Uri "";
        proxy_set_header X-Envoy-Original-Path "";
        proxy_set_header X-Request-URI "";
        proxy_set_header Referer "";

        proxy_pass http://127.0.0.1:18013;
    }

    location ^~ /xiaozhi/v1/ {
        access_log /var/log/nginx/passport_access.log passport_safe if=$passport_log_access;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        proxy_set_header X-Original-URI "";
        proxy_set_header X-Original-URL "";
        proxy_set_header X-Rewrite-URL "";
        proxy_set_header X-Forwarded-Uri "";
        proxy_set_header X-Envoy-Original-Path "";
        proxy_set_header X-Request-URI "";
        proxy_set_header Referer "";

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://127.0.0.1:18010;
    }

    location / {
        return 404;
    }
}
